{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Space Train",
  "version": "0.3.0",
  "identifier": "com.miche.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Space Train",
        "width": 1100,
        "height": 700,
        "minWidth": 640,
        "minHeight": 400,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwMDMxQThBRUFGN0QxODQKUldTRTBmZnFpaG9EUUYzTG1oVkJRVTIzZDR1cUU2aC9kRHJ4OFdmYkZ0SEg4K2RuNjdjRTRpRngK",
      "endpoints": [
        "https://github.com/miky41195/Space-Train/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}